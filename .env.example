# Source Microsoft SQL Server used by migrate_trading.py
MSSQL_HOST=db.example.invalid
MSSQL_PORT=1433
MSSQL_USER=source_user
MSSQL_PASSWORD=

# Optional legacy Windows host access
WINRM_HOST=windows.example.invalid
WINRM_PORT=5985
WINRM_USER=windows_user
WINRM_PASSWORD=

# Optional application timezone (IANA name); empty keeps the PHP/server timezone.
# Controls server-side calendar days; browser date display remains unchanged.
APP_TIMEZONE=Asia/Vladivostok

# Local PostgreSQL used by WebUI and migration
LOCAL_PGSQL_HOST=localhost
LOCAL_PGSQL_PORT=5432
LOCAL_PGSQL_USER=app_user
LOCAL_PGSQL_PASSWORD=
LOCAL_PGSQL_DATABASE=app_db
LOCAL_PGSQL_SCHEMA=public

# Comma-separated source_database:target_schema mappings
MSSQL_MIGRATIONS=source_db:public
# Source databases whose imported actions must never remain protected
MSSQL_CLEAR_PROTECTED=

# PostgreSQL on hosting
HOSTING_PGSQL_HOST=db.example.invalid
HOSTING_PGSQL_PORT=5432
HOSTING_PGSQL_USER=app_user
HOSTING_PGSQL_PASSWORD=
HOSTING_PGSQL_DATABASE=app_db

# Optional hosting deployment access
FTP_KASSA_HOST=files.example.invalid
FTP_KASSA_PORT=21
FTP_KASSA_USER=deploy_user
FTP_KASSA_PASSWORD=

# Optional site administration access
SITE_HOST=app.example.invalid
SITE_USER=site_user
SITE_PASSWORD=

# E2E users: the second account must have can_view_protected=false
E2E_USER=e2e_user
E2E_PASSWORD=
E2E_RESTRICTED_USER=e2e_restricted_user
E2E_RESTRICTED_PASSWORD=
