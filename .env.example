# Source Microsoft SQL Server used by migrate_trading.py
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_MIGRATIONS=trading:vl,khb_trading:khb,uss_trading:uss

# Optional legacy Windows host access
WINRM_HOST=
WINRM_PORT=5985
WINRM_USER=
WINRM_PASSWORD=

# PostgreSQL used by WebUI and migration
LOCAL_PGSQL_HOST=localhost
LOCAL_PGSQL_PORT=5432
LOCAL_PGSQL_USER=postgres
LOCAL_PGSQL_PASSWORD=
LOCAL_PGSQL_DATABASE=berg_kassa

# E2E users: the second account must have can_view_protected=false
E2E_USER=
E2E_PASSWORD=
E2E_RESTRICTED_USER=
E2E_RESTRICTED_PASSWORD=

# PostgreSQL on hosting
HOSTING_PGSQL_HOST=pg4.sweb.ru
HOSTING_PGSQL_PORT=5433
HOSTING_PGSQL_USER=debrskyru_kassa
HOSTING_PGSQL_PASSWORD=
HOSTING_PGSQL_DATABASE=debrskyru_kassa
HOSTING_PGSQL_SCHEMA=vl

# Optional hosting deployment access
FTP_KASSA_HOST=
FTP_KASSA_PORT=21
FTP_KASSA_USER=
FTP_KASSA_PASSWORD=
